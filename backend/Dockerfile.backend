FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /app

# Copy only csproj first (for caching restore)
COPY backend.csproj ./
RUN dotnet restore

# Copy rest of source
COPY . .

# Expose port
EXPOSE 8080

# Development environment
ENV ASPNETCORE_ENVIRONMENT=Development
ENV ASPNETCORE_URLS=http://0.0.0.0:8080

# Run with hot reload
CMD ["dotnet", "watch", "run"]