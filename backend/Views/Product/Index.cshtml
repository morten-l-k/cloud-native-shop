@model IEnumerable<CloudNativeShop.Backend.Models.ProductViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ProductCategoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductNameLength)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductDescriptionLength)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductPhotosQty)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductWeightG)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductLengthCm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductHeightCm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ProductWidthCm)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ProductCategoryName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductNameLength)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductDescriptionLength)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductPhotosQty)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductWeightG)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductLengthCm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductHeightCm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProductWidthCm)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ProductId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ProductId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ProductId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
